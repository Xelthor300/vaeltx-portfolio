# Server-only. Save as a Secret in Vercel Production; never expose or commit it.
RESEND_API_KEY=
# Initial sender is onboarding@resend.dev; recipient must be the Resend account email.
# No unverified VAELTX domain is used.
NEXT_PUBLIC_SITE_URL=
SITE_INDEXABLE=false

# Website Launch Grant — server-only, separate Supabase project and sandbox secrets.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GRANT_ABUSE_HMAC_KEY=
# Supabase Auth must enable Turnstile and use a code email template + verified SMTP.
GRANT_CAPTCHA_SITE_KEY=
# Verified domain sender; onboarding@resend.dev cannot deliver to arbitrary participants.
GRANT_EMAIL_FROM=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ACCOUNT_ID=
GRANT_STRIPE_MODE=test
# Long random bearer secret for the protected email-outbox retry endpoint.
GRANT_OPERATIONS_SECRET=
