# Server-only. Save as a Secret in Vercel Production; never expose or commit it.
RESEND_API_KEY=
# Initial sender is onboarding@resend.dev; recipient must be the Resend account email.
# No unverified VAELTX domain is used.
NEXT_PUBLIC_SITE_URL=
SITE_INDEXABLE=false

# Auction: all variables below are server-only. Never use NEXT_PUBLIC for secrets.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUCTION_SITE_URL=http://localhost:3100
AUCTION_ABUSE_HMAC_KEY=
AUCTION_OPERATIONS_SECRET=
AUCTION_ADMIN_AUTH_EMAIL=
AUCTION_ADMIN_EMAIL=
AUCTION_TURNSTILE_SITE_KEY=
AUCTION_TURNSTILE_SECRET=
# Set only after Supabase Auth CAPTCHA protection is enabled with the matching key.
AUCTION_AUTH_CAPTCHA_PROVIDER=supabase
# smtp for Gmail now; resend remains available for a future verified domain.
AUCTION_EMAIL_TRANSPORT=smtp
AUCTION_SMTP_HOST=smtp.gmail.com
AUCTION_SMTP_PORT=465
AUCTION_SMTP_USER=
# A Google App Password, never the normal Google account password.
AUCTION_SMTP_PASSWORD=
AUCTION_RESEND_API_KEY=
AUCTION_EMAIL_FROM=
STRIPE_ACCOUNT_ID=
STRIPE_SECRET_KEY=
AUCTION_STRIPE_MODE=test
AUCTION_STRIPE_WEBHOOK_SECRET=
# Leave false through preview, production preparation, and final owner review.
AUCTION_ALLOW_ACTIVATION=false


# VAELTX Managed Hosting & Care billing.
# LIVE webhook signing secret. Server-only; store as Sensitive in Vercel Production.
VAELTX_BILLING_WEBHOOK_SECRET=
# Non-secret Stripe resource IDs used to scope webhook events to these two plans only.
VAELTX_HOSTING_US_PRICE_ID=price_1UNj8G4efgtFxxrtKhdFx9TI
VAELTX_HOSTING_US_PAYMENT_LINK_ID=plink_1UNj8Z4efgtFxxrtVEEsCW5x
VAELTX_HOSTING_MX_PRICE_ID=price_1UNj8L4efgtFxxrtICPzpZdV
